{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'group:monorepos',
    'helpers:pinGitHubActionDigests',
    ':semanticPrefixFixDepsChoreOthers',
    ':dependencyDashboard',
  ],

  baseBranchPatterns: ['main'],

  customManagers: [
    {
      customType: 'regex',
      fileMatch: ['^\\.github/workflows/.+\\.ya?ml$'],
      matchStrings: [
        'BUILDISH_RELEASE_TOOLING_REF: (?<currentDigest>[a-f0-9]{40}) # renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)(?: versioning=(?<versioning>.+?))? currentValue=(?<currentValue>.+?)\\s',
      ],
      matchStringsStrategy: 'any',
    },
  ],

  packageRules: [
    {
      matchManagers: [
        'pip_requirements',
        'pip_setup',
        'poetry',
        'setup-cfg',
        'github-actions',
      ],
      automerge: false,
    },
    {
      matchDatasources: [
        'pip_requirements',
        'pip_setup',
        'poetry',
        'setup-cfg',
      ],
      minimumReleaseAge: '3 days',
    },
  ],

  prConcurrentLimit: 50,
  prHourlyLimit: 5,
}
